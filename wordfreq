#!/usr/bin/env python3
"""wordfreq - count word frequencies from stdin or file args.

Tokenization rule: lowercase all text, then extract tokens matching [a-z0-9]+
(i.e. ASCII lowercase letters and digits; all other characters are treated
as delimiters and stripped).
"""
import argparse
import collections
import re
import sys

TOKEN_RE = re.compile(r"[a-z0-9]+")


def tokenize(text):
    return TOKEN_RE.findall(text.lower())


def count_words(texts):
    counter = collections.Counter()
    for text in texts:
        counter.update(tokenize(text))
    return counter


def parse_args(argv=None):
    p = argparse.ArgumentParser(
        prog="wordfreq",
        description="Count word frequencies from stdin or files. "
        "Outputs '<count> <word>' per line, sorted by count desc then word asc.",
    )
    p.add_argument(
        "files",
        nargs="*",
        metavar="FILE",
        help="input files (concatenated); reads stdin when omitted",
    )
    p.add_argument(
        "--top",
        type=int,
        default=10,
        metavar="N",
        help="limit output to top N words (default: 10)",
    )
    args = p.parse_args(argv)
    if args.top is not None and args.top < 1:
        p.error("--top must be >= 1")
    return args


def read_inputs(files):
    texts = []
    if not files:
        texts.append(sys.stdin.read())
    else:
        for path in files:
            try:
                with open(path, "r", encoding="utf-8", errors="replace") as f:
                    texts.append(f.read())
            except FileNotFoundError:
                print(f"wordfreq: {path}: No such file or directory", file=sys.stderr)
                sys.exit(1)
            except IsADirectoryError:
                print(f"wordfreq: {path}: Is a directory", file=sys.stderr)
                sys.exit(1)
            except OSError as e:
                print(f"wordfreq: {path}: {e.strerror or e}", file=sys.stderr)
                sys.exit(1)
    return texts


def main(argv=None):
    args = parse_args(argv)
    texts = read_inputs(args.files)
    counter = count_words(texts)
    ranked = sorted(counter.items(), key=lambda kv: (-kv[1], kv[0]))
    for word, count in ranked[: args.top]:
        sys.stdout.write(f"{count} {word}\n")


if __name__ == "__main__":
    main()
